{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://20.244.4.11/api/:path*"
    },
    {
      "source": "/verify/:path*",
      "destination": "/verify.html"
    },
    {
      "source": "/passport/:path*",
